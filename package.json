{
  "name": "@threadharbor/dsh-chat-area",
  "version": "0.1.0",
  "description": "DSH plugin: in-conversation file reading/editing, Mermaid rendering, session ID display, and answer editing",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./file-view": {
      "types": "./src/file-view/index.ts",
      "default": "./src/file-view/index.ts"
    },
    "./mermaid": {
      "types": "./src/mermaid/index.ts",
      "default": "./src/mermaid/index.ts"
    },
    "./package.json": "./package.json",
    "./session-id-bar": {
      "types": "./src/session-id-bar/index.ts",
      "default": "./src/session-id-bar/index.ts"
    },
    "./answer-edit": {
      "types": "./src/answer-edit/index.ts",
      "default": "./src/answer-edit/index.ts"
    }
  },
  "files": [
    "src",
    "lib"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dsh": {
    "client": {
      "inject": [
        "slots",
        "remote",
        "uiConversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.2 <0.3",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "tsdown": "^0.5.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threadharbor/dsh-chat-area.git"
  }
}
