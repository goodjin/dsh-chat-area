{
  "name": "@goodjin2/dsh-chat-area",
  "version": "0.2.0",
  "description": "DSH plugin: short session ID with a copy button in the conversation header",
  "type": "module",
  "main": "./src/entry.ts",
  "types": "./src/entry.ts",
  "exports": {
    ".": {
      "types": "./src/entry.ts",
      "default": "./src/entry.ts"
    },
    "./client": {
      "types": "./src/index.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./session-id-bar": {
      "types": "./src/session-id-bar/index.ts",
      "default": "./src/session-id-bar/index.ts"
    }
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "build:client": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.2 <0.3",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threadharbor/dsh-chat-area.git"
  }
}
